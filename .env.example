# MirrorFlow 環境變數範本
# 複製為 .env.local 後填入實值。.env.local 已被 .gitignore 排除，絕不可入庫。

# ── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ⚠ 僅限伺服器端使用（researcher 匯出、migration 驗證腳本）。絕不可加 NEXT_PUBLIC_ 前綴。
SUPABASE_SERVICE_ROLE_KEY=

# scripts/verify-rls.ts 專用：PostgreSQL 直連字串。
# Supabase → Project Settings → Database → Connection string，
# 務必用 port 5432 的直連，不要用 6543 的 pooler——pooler 不保證同一條連線，
# 驗證腳本的單一 transaction 會被切斷。
DATABASE_URL=

# ── AI Provider（唯一出口 lib/ai/provider.ts）───────────────
# anthropic | mock（測試與無金鑰開發用，正式環境會被拒絕載入）
# gemini / ollama 尚未實作
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# 單次回覆的最大 token 數。與模型參數同屬三期凍結範圍。
AI_MAX_TOKENS=1024

# 僅 AI_PROVIDER=mock 時有效：每個串流片段之間的延遲毫秒。
# 預設 0（測試要快）；示範給人看時設 30 可觀察到逐字浮現的效果。
MOCK_STREAM_DELAY_MS=0

# ── DNA 三色歸因門檻（鐵則：不得寫死於程式碼）──────────────
# 正規化 Levenshtein 相似度 >= HIGH → 藍（AI 寫的，你沒改）
# LOW <= 相似度 < HIGH             → 綠（AI 寫的，你改過）
# 相似度 < LOW 或無 mark           → 橘（你自己寫的）
# ⚠ 三次作業期間凍結，不得變動。
DNA_THETA_HIGH=0.9
DNA_THETA_LOW=0.5

# ── 反思題目版本（鐵則：三期凍結）───────────────────────────
# reflection_prompts 是版本表，可同時存在多版；這裡指定「現在該出哪一版」。
# v1 由 supabase/migrations/007 建立（三題，各最少 30 字）。
# ⚠ 三次作業期間不得變更，否則「反思品質的變化」與「題目變了」會混淆。
REFLECTION_PROMPT_VERSION=v1

# ── 事件與快照節奏（鐵則：不得寫死）─────────────────────────
SNAPSHOT_INTERVAL_MS=60000
SNAPSHOT_EVENT_COUNT=200

# 一節課的長度（分鐘）。時間到只顯示提醒，不會強制交件。
WRITING_SESSION_MINUTES=90

# ── 認證 ────────────────────────────────────────────────────
# httpOnly JWT cookie 簽章密鑰（STEP 2 使用）
AUTH_JWT_SECRET=
